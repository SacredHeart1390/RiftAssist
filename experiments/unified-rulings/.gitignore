.env
node_modules/
logs/*.jsonl
tmp/
.DS_Store
# Locally collected prototype data; keep out of source-code distribution.
knowledge/cards.json
knowledge/imports/
knowledge/card-history/
knowledge/source-translations/
private/
# Runtime databases and key files must never enter new source changes.
# Existing tracked source-cache databases still require a separate index/history review.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.key
# v0.2.0's isolated runtime, fixtures prepared at runtime, and local config.
releases/v0.2.0/.dev-data/
releases/v0.2.0/riot.config.local.json
releases/v0.2.0/card-translation.config.local.json
releases/v0.2.0/card-sync.config.local.json
releases/v0.2.0/card-review.config.local.json

# Private deployment labs and owned process receipts are never source artifacts.
DeploymentLabs/
ProcessLeases/
*.sealed
*.dpapi

# Independent v0.3 family; never collect runtime/settings in source.
releases/v0.3.0/.dev-data/
releases/v0.3.0/*.local.json

.version-update.lock
