<UserControl x:Class="RiftAssist.ControlCenter.OperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RiftAssist.ControlCenter">
 <UserControl.Resources>
  <Style x:Key="AzureOnly" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AzureMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="DevelopmentOnly" TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding AzureMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel><TextBlock Text="대상" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="ModeCombo" Width="230" SelectedIndex="0" SelectionChanged="Mode_Changed"><ComboBoxItem Content="합성 개발 관리자"/><ComboBoxItem Content="Azure · SSH 읽기 전용"/></ComboBox><TextBlock Text="{Binding TargetLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8"/></WrapPanel>
   <TextBlock Text="{Binding State}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4"/>
   <WrapPanel><Button x:Name="CancelQueryButton" Content="진행 중 SSH 조회 취소" IsEnabled="False" Click="Cancel_Click"/><Button x:Name="RecoverConnectionButton" Content="연결 복구" IsEnabled="{Binding CanRecoverConnection}" Click="RecoverConnection_Click"/><TextBlock Text="Azure는 읽기 전용입니다." VerticalAlignment="Center" Foreground="#8B3F18"/></WrapPanel>
  </StackPanel>
  <Grid x:Name="OpsBody"><TabControl x:Name="OperationsTabs">
   <TabItem Header="대시보드"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <StackPanel Style="{StaticResource DevelopmentOnly}">
     <WrapPanel IsEnabled="{Binding CanPrepareDevelopment}"><Button Content="새 개발 관리자" Click="New_Click"/><ComboBox x:Name="EnvironmentCombo" ItemsSource="{Binding Environments}" Width="260"/><Button Content="개발 환경 연결" Click="Connect_Click"/><Button Content="환경 목록" Click="List_Click"/></WrapPanel>
     <TextBox Text="{Binding LocalRoot, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
     <Button Content="상태 새로고침" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}" Click="Refresh_Click"/>
    </StackPanel>
    <StackPanel Style="{StaticResource AzureOnly}">
     <WrapPanel><Button x:Name="QuerySshButton" Content="서버 상태 조회" IsEnabled="{Binding AzureMode}" Click="Query_Click"/><Button Content="연결 설정" Click="OpenSettings_Click"/></WrapPanel>
     <Separator Margin="0,10"/><TextBlock Text="저장된 SSH 설정으로 서버 상태·관리자·AI 집계·제보 목록을 자동 연결합니다." TextWrapping="Wrap"/>
     <Expander Header="기존 DPAPI / 수동 인증 (호환용)"><StackPanel>
     <Separator Margin="0,10"/><TextBlock Text="운영 관리자 · 읽기 전용" FontWeight="SemiBold"/>
     <TextBlock Text="승인받은 기존 관리자 키로 연결합니다. 저장을 선택하면 Windows 사용자 전용으로 암호화하며 제보 내용은 화면에서만 조회합니다." TextWrapping="Wrap"/>
     <WrapPanel><PasswordBox x:Name="AdminKeyInput" Width="270" MaxLength="1024" ToolTip="기존 관리자 키 · 저장 선택 시에만 Windows 사용자 전용 암호화"/><Button x:Name="ConnectAdminButton" Content="관리자 읽기 연결" Click="AdminConnect_Click"/><Button x:Name="RefreshAdminButton" Content="운영 상태·AI 사용량 조회" IsEnabled="{Binding CanReadAdmin}" Click="AdminRefresh_Click"/></WrapPanel>
     <WrapPanel><CheckBox x:Name="RememberAdminLogin" Content="이 컴퓨터에 로그인 정보 기억" ToolTip="로그인 성공 시 저장합니다. 저장 후 체크를 해제하면 현재 대상의 저장 정보와 연결을 지웁니다." IsChecked="{Binding RememberAdminLogin, Mode=TwoWay}" Margin="4,8"/><CheckBox x:Name="AutoConnectAdmin" Content="이전 DPAPI 자동 연결 옵션" Visibility="Collapsed" ToolTip="기본 꺼짐입니다. 저장된 키가 있으면 이 선택을 바로 저장합니다. 첫 로그인 전에는 로그인 성공 시 적용합니다." IsEnabled="{Binding RememberAdminLogin}" IsChecked="{Binding AutoConnectAtStartup, Mode=TwoWay}" Margin="12,8"/></WrapPanel>
     <WrapPanel><Button x:Name="ConnectSavedAdminButton" Content="저장된 정보로 연결" IsEnabled="{Binding HasSavedLogin}" Click="SavedAdminConnect_Click"/><Button x:Name="ForgetSavedAdminButton" Content="저장된 로그인 정보 삭제" Click="ForgetSavedAdmin_Click"/></WrapPanel>
     <TextBlock x:Name="LoginFeedbackText" Text="{Binding LoginFeedback}" TextWrapping="Wrap" Margin="4"/>
     </StackPanel></Expander>
     <TextBlock x:Name="AdminStateText" Text="{Binding AdminState}" TextWrapping="Wrap" Margin="4"/><TextBlock x:Name="AdminSummaryText" Text="{Binding AdminSummary}" TextWrapping="Wrap" Margin="4"/>

    </StackPanel>
    <DockPanel Margin="4,10"><Button DockPanel.Dock="Right" Content="연결 해제" Click="Disconnect_Click"/><StackPanel><TextBlock x:Name="ConnectionText" Text="{Binding ConnectionStatus}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding SnapshotInfo}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel>
    <ItemsControl x:Name="MetricCards" ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DCE1E7" BorderThickness="1" CornerRadius="5" Padding="12" Margin="4" MinHeight="112"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#44515E"/><TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#5C6672"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Expander Header="조회 상세" Margin="4,12"><TextBox Text="{Binding Dashboard, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="180"/></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="서버 관리"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="{Binding ProductionControlNotice}" TextWrapping="Wrap" Foreground="#873820"/>
    <StackPanel x:Name="ServerControlPanel" IsEnabled="{Binding CanControl}">
     <WrapPanel><Button Content="개발 앱 시작…" Tag="start" Click="Server_Click"/><Button Content="개발 앱 중지…" Tag="stop" Click="Server_Click"/><Button Content="개발 앱 재시작…" Tag="restart" Click="Server_Click"/></WrapPanel>
     <TextBlock Text="공개 연결은 none만 허용합니다. 관리자/앱은 임의 loopback 포트이며 외부 터널을 열지 않습니다." TextWrapping="Wrap"/>
     <Button Content="개발 hosting=none 저장…" HorizontalAlignment="Left" Click="Hosting_Click"/>
     <Separator Margin="0,12"/><TextBlock Text="개발 백업은 DB와 개발 암호화 키를 포함합니다. 선택한 개발 폴더 내부에만 보관하며 외부 반출·Git 포함을 금지합니다." TextWrapping="Wrap"/>
     <Button Content="개발 DB 백업 생성…" HorizontalAlignment="Left" Click="Backup_Click"/>
     <Separator Margin="0,12"/><TextBlock Text="개발 앱 버전 적용 / 되돌리기" FontWeight="SemiBold"/>
     <WrapPanel><ComboBox x:Name="AppReleaseCombo" ItemsSource="{Binding AppReleases}" Width="260"/><Button Content="개발 앱 버전 적용…" Click="AppRelease_Click"/></WrapPanel>
     <TextBlock Text="관리자 자료 조회/수집 요청/전환 (카드 검토·승인 경계를 우회하지 않음)" FontWeight="SemiBold" Margin="0,12,0,4"/>
     <WrapPanel><Button Content="기존 재수집 API 차단 확인…" Click="Discover_Click"/><ComboBox x:Name="KnowledgeCombo" ItemsSource="{Binding KnowledgeReleases}" Width="260"/><Button Content="개발 자료 적용…" Click="Knowledge_Click"/></WrapPanel>
    </StackPanel>
    <WrapPanel><Button x:Name="ProductionStartButton" Content="운영 앱 시작" IsEnabled="{Binding ProductionChangesEnabled}"/><Button Content="운영 앱 중지" IsEnabled="{Binding ProductionChangesEnabled}"/><Button Content="운영 앱 재시작" IsEnabled="{Binding ProductionChangesEnabled}"/></WrapPanel>
    <TextBox Text="{Binding LastResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="70" MaxHeight="140"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="AI 운영"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox Text="{Binding Ai, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="110"/>
    <Button Grid.Row="1" Content="개발 AI 허용/중지 전환…" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}" Click="Ai_Click"/>
    <DataGrid Grid.Row="2" x:Name="LimitsGrid" ItemsSource="{Binding Limits}" IsReadOnly="{Binding LimitsReadOnly}"><DataGrid.Columns><DataGridTextColumn Header="호출 한도" Binding="{Binding Label}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="값" Binding="{Binding Value, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Width="130"/></DataGrid.Columns></DataGrid>
    <Button Grid.Row="3" Content="개발 한도 저장…" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}" Click="Limits_Click"/>
   </Grid></TabItem>
   <TabItem Header="질문·오류 제보"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBox x:Name="ReportFilter" DockPanel.Dock="Right" Width="220" TextChanged="ReportFilter_Changed" ToolTip="ID/분류/상태 검색"/><StackPanel><WrapPanel><Button x:Name="AnalyzeIncidentButton" Content="AI로 오류 분석" Click="AnalyzeIncident_Click"/><Button x:Name="RealCodexButton" Content="Codex로 수정하기" Click="RealCodex_Click"/><Button x:Name="NewManualReportButton" Content="수동 제보 등록" Click="NewManualReport_Click"/><Button x:Name="EditManualReportButton" Content="선택 수동 제보 수정" Click="EditManualReport_Click"/><Button Content="로컬 목록 새로고침" Click="ManualReports_Click"/></WrapPanel><TextBlock Text="{Binding ManualReportFeedback}" TextWrapping="Wrap"/><TextBlock Text="운영/개발 API 제보와 로컬 수동 제보 · Azure는 읽기 전용" TextWrapping="Wrap"/><Button x:Name="ReadAdminReportsButton" Content="운영 제보 목록 조회 (최대 200개)" HorizontalAlignment="Left" IsEnabled="{Binding CanReadAdmin}" Click="AdminReports_Click"/></StackPanel></DockPanel>
    <DataGrid x:Name="ReportsGrid" Grid.Row="1" ItemsSource="{Binding Reports}" IsReadOnly="True" SelectionChanged="Report_Changed"><DataGrid.Columns><DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="115"/><DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="140"/><DataGridTextColumn Header="제보 ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="90"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="접수 시각" Binding="{Binding Created}" Width="160"/></DataGrid.Columns></DataGrid>
    <TextBox x:Name="ReportDetailText" Grid.Row="2" Text="{Binding ReportDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    <WrapPanel Grid.Row="3" IsEnabled="{Binding CanControl}"><ComboBox x:Name="ReportState" ItemsSource="{Binding ReportStates}" SelectedIndex="0" Width="125"/><TextBox x:Name="ReportNote" Width="280" MaxLength="3000" ToolTip="개발 처리 메모 · 개인정보/키 입력 금지"/><Button Content="개발 제보 처리 저장…" Click="ReportUpdate_Click"/><Button Content="합성 제보 JSON 내보내기" Click="Export_Click"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="카드 관리"><StackPanel Margin="18"><TextBlock Text="기존 카드·번역 검토는 상위 ‘카드·번역 검토’, ‘최종 승인·롤백·복구’, ‘감사 기록’ 탭에서 계속 사용합니다." TextWrapping="Wrap" FontSize="16"/><TextBlock Text="개발 관리자와 카드 검토는 별도 GUID 폴더를 사용합니다. Azure 카드 DB 조회·교체는 연결하지 않았습니다." TextWrapping="Wrap" Margin="0,15"/></StackPanel></TabItem>
   <TabItem Header="시스템 로그"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="80"/><RowDefinition Height="110"/></Grid.RowDefinitions>
    <DockPanel><Button DockPanel.Dock="Right" Content="개발 감사 기록 갱신" IsEnabled="{Binding CanControl}" Click="Logs_Click"/><TextBlock Text="개발 작업 감사 기록과 연결 상태 기록" TextWrapping="Wrap"/></DockPanel>
    <DataGrid x:Name="EventsGrid" Grid.Row="1" ItemsSource="{Binding Events}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="시각" Binding="{Binding At}" Width="200"/><DataGridTextColumn Header="작업" Binding="{Binding Action}" Width="130"/><DataGridTextColumn Header="결과" Binding="{Binding Outcome}" Width="110"/><DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
    <TextBox Grid.Row="2" Text="{Binding SelectedItem.Reason, ElementName=EventsGrid, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <ListBox Grid.Row="3" ItemsSource="{Binding LocalEvents}" FontSize="12"/>
   </Grid></TabItem>
   <TabItem Header="설정"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsForm" Margin="16" MaxWidth="780" HorizontalAlignment="Left">
    <TextBlock Text="Azure SSH 연결" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="서버 주소 (DNS 또는 IP)"/><TextBox x:Name="HostInput" MinWidth="480" MaxLength="253" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" ToolTip="SSH config 별칭 대신 실제 DNS 또는 IP를 입력하세요."/>
    <WrapPanel><StackPanel Width="340"><TextBlock Text="SSH 계정"/><TextBox x:Name="UserInput" MaxLength="64" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="140"><TextBlock Text="SSH 포트"/><TextBox x:Name="PortInput" MaxLength="5"><TextBox.Text><Binding Path="Port" UpdateSourceTrigger="PropertyChanged"><Binding.ValidationRules><local:SshPortValidationRule/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel></WrapPanel>
    <TextBlock Text="개인키 파일 (선택)" Margin="0,8,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="찾아보기" Tag="identity" Click="Browse_Click"/><TextBox x:Name="IdentityInput" MaxLength="1024" Text="{Binding IdentityFile, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
    <TextBlock Text="Windows ssh-agent를 사용하면 생략할 수 있습니다. 키 내용은 저장하지 않습니다." TextWrapping="Wrap" Foreground="#5C6672" Margin="4"/>
    <TextBlock Text="검증된 known_hosts 파일" Margin="0,8,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="찾아보기" Tag="known" Click="Browse_Click"/><TextBox x:Name="KnownHostsInput" MaxLength="1024" Text="{Binding KnownHostsFile, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
    <TextBlock Text="웹사이트 HTTPS 주소" Margin="0,8,0,0"/><TextBox x:Name="OriginInput" MaxLength="2048" Text="{Binding HttpsOrigin, UpdateSourceTrigger=PropertyChanged}" ToolTip="예: https://example.invalid (경로 없이 입력)"/>
    <WrapPanel Margin="0,12"><Button x:Name="SaveSshSettings" Content="설정 저장" Click="SaveSettings_Click"/><Button Content="저장된 설정 불러오기" Click="ReloadSettings_Click"/></WrapPanel>
    <TextBlock x:Name="SettingsMessage" Text="{Binding SettingsFeedback}" TextWrapping="Wrap" Margin="4"/>
    <Expander Header="연결 도움말" Margin="4,14"><TextBlock Text="Windows OpenSSH Client와 기존 키/agent를 준비하세요. 호스트 키는 사전에 확인한 known_hosts로 검증하며 미등록·변경 키는 거절합니다. HTTPS /와 앱 기본 3001의 정적 페이지를 조회합니다. 신규 세션을 만드는 /api/health는 호출하지 않습니다. 설정 저장은 연결을 시작하지 않습니다. 별도 관리자 읽기 연결은 SSH 표준입출력으로 원격 loopback 3100의 기존 로그인/API를 사용합니다. 운영 변경은 차단합니다." TextWrapping="Wrap"/></Expander>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl></Grid>
 </DockPanel>
</UserControl>
