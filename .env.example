# Copy this file to .env and add your own API key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Enable only after billing and usage limits are ready. Restart the server after editing.
OPENAI_GENERATION_ENABLED=false
OPENAI_REASONING_EFFORT=low
# Includes reasoning and visible answer tokens. Incomplete answers are not retried automatically.
OPENAI_MAX_OUTPUT_TOKENS=4096
LOG_CONTENT=false
